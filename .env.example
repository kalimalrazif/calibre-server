# Copy to .env (git-ignored) and set your Calibre library path.
# docker compose reads .env automatically, so you can then just run
#   docker compose up -d
# instead of prefixing CALIBRE_LIBRARY=... on every command.
#
# This must be the directory that contains metadata.db AND the author folders
# with the actual book files / covers — not the source repo.
CALIBRE_LIBRARY=/path/to/your/Calibre
